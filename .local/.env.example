# Per-machine values for switchx dev-environment scripts.
# Copy: cp .local/.env.example .local/.env  — then edit.
# Pattern: @Local Development baseline (Taelron Baselines, Linear).

# === Required ===

# Azure Key Vault holding the dev database credentials.
AZURE_VAULT=your-dev-vault

# === Optional ===

# Azure subscription to use when scripting the wizard. Defaults to
# `az account show --query name -o tsv`. Set this when you work across
# multiple Azure subscriptions (e.g. day-job + side projects) and need
# to be explicit about which one switchx scripts target.
# AZURE_SUBSCRIPTION=

# KV secret names per the switchx operator contract (ADR-0005).
# Override only if your vault uses different secret names.
KV_USER_REF=SWITCHX-DB-USER
KV_PASSWORD_REF=SWITCHX-DB-PASSWORD

# Local Postgres coordinates. Defaults match a standard systemd install.
PG_HOST=localhost
PG_PORT=5432
PG_DB=switchx
PG_SSLMODE=disable
PG_SERVICE=postgresql
PG_USER=switchx_user
